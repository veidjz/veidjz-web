{
  "name": "veidjz-web",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --filter @veidjz/web dev",
    "build": "pnpm -r --filter @veidjz/web... build",
    "storybook": "pnpm --filter @veidjz/ui storybook",
    "build-storybook": "pnpm --filter @veidjz/ui build-storybook",
    "check-disables": "node scripts/check-disables.mjs",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "lint": "pnpm check-disables && pnpm lint:biome && pnpm lint:eslint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "quality": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || true"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json,css,md}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "lefthook": "2.1.10",
    "lint-staged": "17.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
